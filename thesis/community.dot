digraph community {
rankdir=LR;
node [shape=circle];
edge [dir=none];

subgraph cluster_A {
style=filled;
color=lightgrey;
A1 -> A2;
A2 -> A3;
A3 -> A4;
A4 -> A1;
A1 -> A3;
A2 -> A4;
}

subgraph cluster_B {
style=filled;
color=lightblue;
B1 -> B2;
B2 -> B3;
B3 -> B4;
B4 -> B1;
B1 -> B3;
B2 -> B4;
}

subgraph cluster_C {
style=filled;
color=lightyellow;
C1 -> C2;
C2 -> C3;
C3 -> C4;
C4 -> C1;
C1 -> C3;
C2 -> C4;
}

A4 -> B1;
B4 -> C1;
A2 -> C3;
}
