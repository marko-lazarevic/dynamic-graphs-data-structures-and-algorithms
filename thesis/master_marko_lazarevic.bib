@article{angrimanBatchdynamicSuitorAlgorithm2022,
  title = {A {{Batch-dynamic Suitor Algorithm}}~for {{Approximating Maximum Weighted Matching}}},
  author = {Angriman, Eugenio and Boro{\'n}, Micha{\l} and Meyerhenke, Henning},
  year = 2022,
  month = jul,
  journal = {ACM J. Exp. Algorithmics},
  volume = {27},
  pages = {1.6:1--1.6:41},
  issn = {1084-6654},
  doi = {10.1145/3529228},
  urldate = {2026-05-24},
  abstract = {Matching is a popular combinatorial optimization problem with numerous applications in both commercial and scientific fields. Computing optimal matchings w.r.t. cardinality or weight can be done in polynomial time; still, this task can become infeasible for very large networks. Thus, several approximation algorithms that trade solution quality for a faster running time have been proposed. For networks that change over time, fully dynamic algorithms that efficiently maintain an approximation of the optimal matching after a graph update have been introduced as well. However, no semi- or fully dynamic algorithm for (approximate) maximum weighted matching has been implemented.In this article, we focus on the problem of maintaining a  \textbackslash ( 1/2 \textbackslash ) -approximation of a maximum weighted matching (MWM) in fully dynamic graphs. Limitations of existing algorithms for this problem are (i) high constant factors in their time complexity, (ii) the fact that none of them supports batch updates, and (iii) the lack of a practical implementation, meaning that their actual performance on real-world graphs has not been investigated. We propose and implement a new batch-dynamic  \textbackslash ( 1/2 \textbackslash ) -approximation algorithm for MWM based on the Suitor algorithm and its local edge domination strategy [Manne and Halappanavar, IPDPS 2014]. We provide a detailed analysis of our algorithm and prove its approximation guarantee. Despite having a worst-case running time of \textbackslash ( \textbackslash mathcal \textbraceleft O\textbraceright (n + m) \textbackslash )  for a single graph update, our extensive experimental evaluation shows that our algorithm is much faster in practice. For example, compared to a static recomputation with sequential Suitor, single-edge updates are handled up to  \textbackslash ( 10\textasciicircum 5\textbackslash times \textbackslash )  to  \textbackslash ( 10\textasciicircum 6\textbackslash times \textbackslash )  faster, while batches of  \textbackslash ( 10\textasciicircum 4 \textbackslash )  edge updates are handled up to  \textbackslash ( 10\textasciicircum 2\textbackslash times \textbackslash )  to  \textbackslash ( 10\textasciicircum 3\textbackslash times \textbackslash )  faster.},
  file = {/home/marko/Zotero/storage/QBUK9W4X/Angriman et al. - 2022 - A Batch-dynamic Suitor Algorithm for Approximating Maximum Weighted Matching.pdf}
}

